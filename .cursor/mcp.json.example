{
  "mcpServers": {
    "planlog": {
      "command": "uv",
      "args": ["run", "planlog-mcp"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PLANLOG_API_URL": "http://localhost:8000",
        "PLANLOG_API_KEY": "your-api-key-here",
        "PLANLOG_ORG_ID": "your-organization-uuid"
      }
    }
  }
}
